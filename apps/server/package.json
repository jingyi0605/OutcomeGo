{
  "name": "@aiteamos/server",
  "version": "0.1.0-beta.12",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun ../../packages/plugins/scripts/generate.ts && bun build src/main.ts --outdir dist --target bun --external pg-native",
    "dev": "bun ../../packages/plugins/scripts/generate.ts && bun --watch src/main.ts",
    "start": "bun dist/main.js",
    "typecheck": "bun ../../packages/plugins/scripts/generate.ts && tsc -p tsconfig.json",
    "test": "bun ../../packages/plugins/scripts/generate.ts && bun test --pass-with-no-tests"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@aiteamos/contracts": "workspace:*",
    "@aiteamos/db": "workspace:*",
    "@aiteamos/messaging": "workspace:*",
    "@aiteamos/plugin-sdk": "workspace:*",
    "@aiteamos/plugins": "workspace:*",
    "better-auth": "1.7.2",
    "effect": "3.22.1",
    "pg": "8.23.0",
    "pg-boss": "12.28.0"
  },
  "devDependencies": {
    "@types/pg": "8.15.5",
    "playwright-core": "1.55.0",
    "@types/node": "22.19.19"
  }
}
