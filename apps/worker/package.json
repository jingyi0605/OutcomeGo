{
  "name": "@aiteamos/worker",
  "version": "0.1.0-beta.4",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build src/main.ts src/healthcheck.ts --outdir dist --target node --format esm --external pg-native",
    "dev": "bun --watch src/main.ts",
