<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme used once the splash is dismissed; keeps the canvas colour behind Compose. -->
    <style name="Theme.OutcomeGo" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/outcomego_canvas</item>
        <item name="android:colorBackground">@color/outcomego_canvas</item>
    </style>

    <style name="Theme.OutcomeGo.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/outcomego_canvas</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.OutcomeGo</item>
    </style>
</resources>
