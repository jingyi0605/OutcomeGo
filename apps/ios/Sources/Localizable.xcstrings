        }
      }
    },
    "“Remind me to send the invoices on Friday.”": {
      "localizations": {
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "“提醒我周五发送发票。”"
          }
        }
      }
    }
  },
  "version": "1.0"
}
