DATABASE_URL=postgresql://outcomego:outcomego@127.0.0.1:5432/outcomego
OUTCOMEGO_PORT=8787
OUTCOMEGO_SERVER_URL=http://127.0.0.1:8787
OUTCOMEGO_COMPUTER_URL=http://127.0.0.1:8790
OUTCOMEGO_COMPUTER_PORT=8790
OUTCOMEGO_CONTROL_TOKEN=replace-with-a-random-local-token
OUTCOMEGO_AUTH_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
OUTCOMEGO_PROXY_SECRET=replace-with-another-random-secret-of-at-least-32-characters
# "required" uses the owner username/password session for every product API client.
# WARNING: "disabled" removes product API authentication; use it only on a fully trusted network.
OUTCOMEGO_AUTH_MODE=required
OUTCOMEGO_WORKSPACE_ROOT=/workspace
OUTCOMEGO_AGENT_DATA_ROOT=/home/box/agent-data
OUTCOMEGO_ASSET_ROOT=/asset-store
OUTCOMEGO_ACCESS_MODE=local
OUTCOMEGO_BIND_HOST=127.0.0.1
OUTCOMEGO_VIEWER_BIND_HOST=127.0.0.1
OUTCOMEGO_VIEWER_PORT_START=6200
OUTCOMEGO_VIEWER_PORT_END=6299
OUTCOMEGO_PUBLIC_HOST=127.0.0.1
OUTCOMEGO_PUBLIC_URL=http://127.0.0.1:8787
OUTCOMEGO_AUTH_URL=http://127.0.0.1:8787
OUTCOMEGO_UPDATE_CHANNEL=beta
COMPOSE_PROFILES=direct
OUTCOMEGO_PI_AGENT_DIR=/home/box/.pi/agent
# Optional absolute path inside the server container to an outcomeGo marketplace v1 JSON manifest.
OUTCOMEGO_MARKETPLACE_FILE=
OUTCOMEGO_SUBAGENT_PER_PARENT_LIMIT=4
OUTCOMEGO_SUBAGENT_GLOBAL_LIMIT=8
OUTCOMEGO_WORKER_CONCURRENCY=8
# Native Swift iOS push delivery.
OUTCOMEGO_APNS_KEY_ID=
OUTCOMEGO_APNS_TEAM_ID=
OUTCOMEGO_APNS_TOPIC=dev.openteam.mobile.swift
# PEM-encoded APNs .p8 key; alternatively set OUTCOMEGO_APNS_PRIVATE_KEY_FILE in the worker.
OUTCOMEGO_APNS_PRIVATE_KEY=

# Each headed agent desktop and its descendant processes: 10 GiB hard ceiling.
OUTCOMEGO_DESKTOP_MEMORY_LIMIT=10g
# All desktops + shared computer runtime. Effective ceiling is the smaller of
# this value and 75% of Linux host/Docker VM RAM. Swap is disabled for computer.
OUTCOMEGO_COMPUTER_MEMORY_LIMIT=12g
