DATABASE_URL=postgresql://aiteamos:aiteamos@127.0.0.1:5432/aiteamos
AITEAMOS_PORT=8787
AITEAMOS_SERVER_URL=http://127.0.0.1:8787
AITEAMOS_COMPUTER_URL=http://127.0.0.1:8790
AITEAMOS_COMPUTER_PORT=8790
AITEAMOS_CONTROL_TOKEN=replace-with-a-random-local-token
AITEAMOS_AUTH_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
AITEAMOS_PROXY_SECRET=replace-with-another-random-secret-of-at-least-32-characters
# "required" uses the owner username/password session for every product API client.
# WARNING: "disabled" removes product API authentication; use it only on a fully trusted network.
AITEAMOS_AUTH_MODE=required
AITEAMOS_WORKSPACE_ROOT=/workspace
AITEAMOS_AGENT_DATA_ROOT=/home/box/agent-data
AITEAMOS_ASSET_ROOT=/asset-store
AITEAMOS_ACCESS_MODE=local
AITEAMOS_BIND_HOST=127.0.0.1
AITEAMOS_VIEWER_BIND_HOST=127.0.0.1
AITEAMOS_VIEWER_PORT_START=6200
AITEAMOS_VIEWER_PORT_END=6299
AITEAMOS_PUBLIC_HOST=127.0.0.1
AITEAMOS_PUBLIC_URL=http://127.0.0.1:8787
AITEAMOS_AUTH_URL=http://127.0.0.1:8787
AITEAMOS_UPDATE_CHANNEL=beta
COMPOSE_PROFILES=direct
AITEAMOS_PI_AGENT_DIR=/home/box/.pi/agent
# Optional absolute path inside the server container to an aiTeamOS marketplace v1 JSON manifest.
AITEAMOS_MARKETPLACE_FILE=
AITEAMOS_SUBAGENT_PER_PARENT_LIMIT=4
AITEAMOS_SUBAGENT_GLOBAL_LIMIT=8
AITEAMOS_WORKER_CONCURRENCY=8
# Native Swift iOS push delivery.
AITEAMOS_APNS_KEY_ID=
AITEAMOS_APNS_TEAM_ID=
AITEAMOS_APNS_TOPIC=dev.openteam.mobile.swift
# PEM-encoded APNs .p8 key; alternatively set AITEAMOS_APNS_PRIVATE_KEY_FILE in the worker.
AITEAMOS_APNS_PRIVATE_KEY=

# Each headed agent desktop and its descendant processes: 10 GiB hard ceiling.
AITEAMOS_DESKTOP_MEMORY_LIMIT=10g
# All desktops + shared computer runtime. Effective ceiling is the smaller of
# this value and 75% of Linux host/Docker VM RAM. Swap is disabled for computer.
AITEAMOS_COMPUTER_MEMORY_LIMIT=12g
