model AutomationWebhookSettings {
  id String   @id @default("global")
  publicUrl String?
  updatedAt DateTime @updatedAt
  @@map("outcomego_automation_webhook_settings")
}

// Single deployment owner's registered physical computers. Offline devices stay listed.
model HostMachine {
  machineId String @id
  label String
  bridgeUrl String? @unique
  transport String @default("direct")
  credentialHash String?
  authSessionId String?
  enabled Boolean @default(true)
  lastSeenAt DateTime?
  // Messages state as the desktop reports it. Only the Mac itself turns Messages on;
  // null means the app has not reported Messages support (not a Mac, or an older app).
  messagesEnabled Boolean @default(false)
  messagesPermissions Json?
  // Skips the approval card for every SendIMessage on this Mac.
  messagesSendWithoutAsking Boolean @default(false)
  messagesAllowedRecipients MessagesAllowedRecipient[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("outcomego_host_machine")
}

/// A handle the user allowed a Mac to text without an approval card.
model MessagesAllowedRecipient {
