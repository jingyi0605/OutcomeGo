  machine HostMachine @relation(fields: [machineId], references: [machineId], onDelete: Cascade)
  recipient String
  recipientName String?
  createdAt DateTime @default(now())

  @@id([machineId, recipient], map: "outcomego_messages_allowed_recipient_machine_id_recipient_pkey")
  @@map("outcomego_messages_allowed_recipient")
}

model ComputerDisplaySettings {
  id String @id @default("global")
  width Int @default(1280)
  height Int @default(800)
  updatedAt DateTime @updatedAt
  @@map("outcomego_computer_display_settings")
}

// Desired egress/order survives disconnects. Server fallback requires an explicit ranked entry.
model BrowserNetworkSettings {
  id String @id @default("global")
  deploymentId String @default(uuid())
  mode String @default("ranked")
  machineId String?
  sourceOrder String[] @default(["server"])
  revision Int @default(1)
  updatedAt DateTime @updatedAt
  @@map("outcomego_browser_network_settings")
}

model ComputerNetworkPolicy {
  id String @id @default("global")
  mode String @default("lan")
  rules Json @default("[]")
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("outcomego_computer_network_policy")
}

