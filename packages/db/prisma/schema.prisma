/// Routes one Connection's inbound messages to one Bot (specs/009). Holds the Server's
/// acknowledgement cursor, which is separate from any provider cursor kept by the connector.
model ExternalMessagingBinding {
  id String @id @default(uuid()) @db.Uuid
  connectionId String @unique(map: "outcomego_external_messaging_binding_connection_id_key") @db.Uuid
  connection PluginConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  botId String @db.Uuid
  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)
  enabled Boolean @default(true)
  /// Only `owner_only` exists: the connector must prove the sender owns the account.
  inboundPolicy String @default("owner_only")
  /// `active` or `needs_attention`.
  status String @default("active")
  inboundCursor String?
  leaseOwner String?
  leaseExpiresAt DateTime?
  retryAckCursor String?
  retryCount Int @default(0)
  retryFirstAt DateTime?
  consecutiveFailures Int @default(0)
  lastPolledAt DateTime?
  lastAcceptedAt DateTime?
  lastErrorCode String?
  lastErrorAt DateTime?
  rejectedCounts Json @default("{}")
  /// Daily nudge to write to the account so the platform's reply window stays open. Only offered
  /// when the connector declares a `replyWindow`.
  reminderEnabled Boolean @default(false)
  /// Local time of day in the user's time zone, `HH:MM`.
  reminderTime String @default("20:00")
  /// The local date (`YYYY-MM-DD`) a reminder was last claimed for: at most one per day.
  lastReminderOn String?
  lastReminderAt DateTime?
  /// `sent`, `failed` or `uncertain`; never carries text.
  lastReminderOutcome String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([botId], map: "outcomego_external_messaging_binding_bot_id_idx")
  @@index([enabled, status, leaseExpiresAt], map: "outcomego_external_messaging_binding_poll_idx")
  @@map("outcomego_external_messaging_binding")
}

/// `(connection, peer, bot)` identity of an external contact. Holds no reply credential. Messages
/// land in the Bot's own `bot_dm`; `channelId` is set only on legacy rows from when each contact had
/// an `external_dm` Channel of its own.
model ExternalChannelMapping {
  id String @id @default(uuid()) @db.Uuid
  connectionId String @db.Uuid
  connection PluginConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  botId String @db.Uuid
  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)
  peerId String
  platform String
  peerType String @default("direct")
  channelId String? @unique(map: "outcomego_external_channel_mapping_channel_id_key") @db.Uuid
  channel Channel? @relation(fields: [channelId], references: [id], onDelete: Cascade)
  /// Display only; never an identity key.
  displayName String?
  /// `active` or `archived`.
  status String @default("active")
  lastInboundAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  receipts ExternalMessageReceipt[]
  deliveries ExternalOutboundDelivery[]

  @@unique([connectionId, peerId, botId], map: "outcomego_external_channel_mapping_identity_key")
  @@index([botId], map: "outcomego_external_channel_mapping_bot_id_idx")
  @@map("outcomego_external_channel_mapping")
}

/// Idempotency record for one provider message. Written only in a terminal state.
model ExternalMessageReceipt {
  id String @id @default(uuid()) @db.Uuid
  connectionId String @db.Uuid
  connection PluginConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  providerMessageId String
  peerId String
  /// SHA-256 of the normalized payload, 64 lowercase hex characters.
  payloadHash String
  /// `accepted` or `rejected`; there is deliberately no in-progress state.
  status String
  rejectionCode String?
  mappingId String? @db.Uuid
  mapping ExternalChannelMapping? @relation(fields: [mappingId], references: [id], onDelete: SetNull)
  channelMessageId String? @db.Uuid
  channelMessage ChannelMessage? @relation(fields: [channelMessageId], references: [id], onDelete: SetNull)
  runId String? @db.Uuid
  run Run? @relation(fields: [runId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@unique([connectionId, providerMessageId], map: "outcomego_external_message_receipt_provider_key")
  @@index([createdAt], map: "outcomego_external_message_receipt_created_at_idx")
  @@map("outcomego_external_message_receipt")
}

/// One outbound send. Never retried automatically: `failed` means nothing was sent,
/// `uncertain` means it may have been.
model ExternalOutboundDelivery {
  /// Also the `deliveryId` passed to the connector.
  id String @id @default(uuid()) @db.Uuid
  /// `external-delivery:<toolCallId>`
  callId String @unique(map: "outcomego_external_outbound_delivery_call_id_key")
  connectionId String @db.Uuid
  connection PluginConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  mappingId String? @db.Uuid
  mapping ExternalChannelMapping? @relation(fields: [mappingId], references: [id], onDelete: SetNull)
  botId String @db.Uuid
  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)
  runId String? @db.Uuid
  run Run? @relation(fields: [runId], references: [id], onDelete: SetNull)
  channelMessageId String @unique(map: "outcomego_external_outbound_delivery_channel_message_id_key") @db.Uuid
  channelMessage ChannelMessage @relation(fields: [channelMessageId], references: [id], onDelete: Cascade)
  /// `pending`, `sending`, `sent`, `failed` or `uncertain`.
  status String @default("pending")
  errorCode String?
  errorMessage String?
  /// Allow-listed provider result: `providerMessageIds` and `note` only.
  providerResult Json?
  startedAt DateTime?
  completedAt DateTime?
  /// Unique per dispatch operation; cleared in a terminal state.
  deliveryLeaseOwner String?
  /// Database-clock deadline, renewed while staging media and calling the connector.
  deliveryLeaseExpiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, deliveryLeaseExpiresAt], map: "outcomego_external_outbound_delivery_recovery_idx")
  @@index([mappingId, createdAt], map: "outcomego_external_outbound_delivery_mapping_idx")
  @@index([connectionId, status], map: "outcomego_external_outbound_delivery_connection_idx")
  @@map("outcomego_external_outbound_delivery")
}

model User {
